        "effective_reliability": 1
      },
      "targets": [
        "declared_local_D_and_model_paths"
      ],
      "caution": "Do not normalize away intended attenuation, equate high confidence with correctness, impose a universal probability gate, or turn a regional prior into truth."
    },
    {
      "id": "M04",
      "name": "confusable_class_pair_separation",
