          1,
          1
        ]
      },
      "targets": [
        "local_D_source",
        "local_D_target",
        "model_local_adversarial_loss"
      ],
      "caution": "Pixel priority preserves within-pixel class proportions; channel reweighting changes the joint soft-label target. Wrong predicted classes can be amplified."
    },
    {
      "id": "M03",
      "name": "alignment_reliability",
      "implementation_status": "new_design",
      "priority": "first_integration",
      "controls": [
