        "strength": 0
      },
      "targets": [
        "declared_trainable_model_features"
      ],
      "caution": "A distance on frozen raw inputs supplies no intended model gradient. Pseudo-label errors and multimodal class structure can invalidate a single-centroid remedy. No MCC or CCA-LSC implementation is claimed."
    },
    {
      "id": "M05",
      "name": "class_contribution_and_mass_correction",
