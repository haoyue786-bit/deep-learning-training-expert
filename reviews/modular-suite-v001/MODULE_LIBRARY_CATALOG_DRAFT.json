  "modules": [
    {
      "id": "M01",
      "name": "adversarial_path_balance",
      "implementation_status": "existing_branches_need_independent_controls",
      "priority": "first_integration",
      "controls": [
        "model_local_scale",
        "model_global_scale",
        "optional_separate_local_global_D_optimization"
      ],
      "neutral": {
        "model_local_scale": 1,
        "model_global_scale": 1
      },
      "targets": [
        "model_local_adversarial_loss",
        "model_global_adversarial_loss"
      ],
      "caution": "A zero model-side scale does not itself disable opponent updates or forward/buffer effects."
    },
    {
      "id": "M02",
      "name": "class_related_alignment_priority",
      "implementation_status": "new_design",
      "priority": "first_integration",
      "controls": [
        "class_multipliers",
        "pixel_priority_or_joint_channel_reweighting",
        "normalization_policy"
      ],
      "neutral": {
